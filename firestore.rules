// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: settings
// Document: global
// Fields:
//   - mainSheetUrl: string (required) - link to the routine sheet
//   - infoGid: string (optional) - GID for the teacher info sheet
//   - semesterGids: map (optional) - mapping of semester numbers to GIDs
//
// Collection: notices
// Document: current
// Fields:
//   - text: string (required, max 1000) - current notice message
//   - active: bool (required) - display status
//   - createdAt: timestamp (optional) - time of creation
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             (
               ("email" in request.auth.token && request.auth.token.email == "mafikulmovie@gmail.com") ||
               (
                 exists(/databases/$(database)/documents/settings/global) &&
                 'adminEmails' in get(/databases/$(database)/documents/settings/global).data &&
                 "email" in request.auth.token &&
                 request.auth.token.email in get(/databases/$(database)/documents/settings/global).data.adminEmails
               ) ||
               (
                 exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
               )
             );
    }
    
    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidSettings(data) {
      return data.mainSheetUrl is string && 
             data.mainSheetUrl.size() > 10 &&
             data.mainSheetUrl.size() < 500 &&
             (!('infoGid' in data) || data.infoGid is string) &&
             (!('semesterGids' in data) || data.semesterGids is map) &&
             (!('githubUsername' in data) || data.githubUsername is string) &&
             (!('adminEmails' in data) || (data.adminEmails is list && data.adminEmails.size() < 50)) &&
             (!('devName' in data) || data.devName is string) &&
             (!('devStudentId' in data) || data.devStudentId is string) &&
             (!('devFacebook' in data) || data.devFacebook is string) &&
             (!('devLinkedin' in data) || data.devLinkedin is string) &&
             (!('devWhatsapp' in data) || data.devWhatsapp is string) &&
             (!('devProfileImage' in data) || (data.devProfileImage is string && data.devProfileImage.size() < 1000)) &&
             (!('busSchedule' in data) || (data.busSchedule is list && data.busSchedule.size() < 100));
    }

    function isValidNotice(data) {
      return data.text is string && 
             data.text.size() > 0 && 
             data.text.size() < 1000 &&
             data.active is bool &&
             (!('type' in data) || data.type in ['normal', 'important']) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is number);
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid.size() > 0 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.role in ['user', 'admin'] &&
             (!('fullName' in data) || data.fullName is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /settings/global {
      allow read: if true; // Public configuration
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    match /notices/current {
      allow read: if true; // Public notices
      allow write: if isAdmin() && isValidNotice(request.resource.data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && isValidUser(request.resource.data) && hasOnlyAllowedFields(request.resource.data, ['uid', 'email', 'fullName', 'role', 'createdAt']) && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
